<?xml version="1.0" encoding="utf-8"?>
<!-- «Оскар»: категории и общий прогресс, ряд церемоний, номинанты выбранной церемонии -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/oscar_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="32dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_padding">

        <TextView
            style="@style/PageTitle"
            android:layout_marginEnd="28dp"
            android:text="@string/nav_oscar" />

        <LinearLayout
            android:id="@+id/oscar_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Общий прогресс по выбранной категории -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_padding"
        android:paddingEnd="@dimen/content_padding">

        <ProgressBar
            android:id="@+id/oscar_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="180dp"
            android:layout_height="4dp"
            android:layout_marginEnd="12dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_thin" />

        <TextView
            android:id="@+id/oscar_progress_text"
            style="@style/Meta"
            android:textColor="@color/text" />
    </LinearLayout>

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/oscar_years"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/content_padding"
        android:paddingTop="3dp"
        android:paddingEnd="@dimen/content_padding"
        android:paddingBottom="3dp" />

    <TextView
        android:id="@+id/oscar_info"
        style="@style/Meta"
        android:layout_marginStart="@dimen/content_padding"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/content_padding"
        android:textColor="@color/text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- focusOutFront: вверх с первого ряда — к церемониям -->
        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/oscar_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/content_padding"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/content_padding"
            android:paddingBottom="24dp"
            app:focusOutFront="true" />

        <TextView
            android:id="@+id/oscar_status"
            style="@style/Meta"
            android:layout_gravity="center"
            android:layout_marginBottom="60dp"
            android:gravity="center"
            android:maxLines="3"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
