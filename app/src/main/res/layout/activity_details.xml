<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:layout_width="500dp"
        android:layout_height="match_parent"
        android:layout_gravity="end">

        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fade_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_gravity="bottom"
            android:background="@drawable/fade_bottom" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="540dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="40dp">

        <TextView
            android:id="@+id/title"
            style="@style/HeroTitle" />

        <TextView
            android:id="@+id/original_title"
            style="@style/Meta"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/meta"
            style="@style/Meta"
            android:layout_marginTop="8dp"
            android:maxLines="2" />

        <TextView
            android:id="@+id/ratings"
            style="@style/Meta.Accent"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/description"
            style="@style/Description"
            android:layout_marginTop="12dp"
            android:maxLines="4" />

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/play"
                style="@style/ActionButton.Primary"
                android:drawableStart="@drawable/ic_play"
                android:text="@string/play">

                <requestFocus />
            </TextView>

            <TextView
                android:id="@+id/next"
                style="@style/ActionButton"
                android:drawableStart="@drawable/ic_skip_next"
                android:visibility="gone" />

            <TextView
                android:id="@+id/episodes"
                style="@style/ActionButton"
                android:drawableStart="@drawable/ic_episodes"
                android:text="@string/episodes_button"
                android:visibility="gone" />

            <TextView
                android:id="@+id/translator"
                style="@style/ActionButton"
                android:drawableStart="@drawable/ic_voice"
                android:visibility="gone" />

            <TextView
                android:id="@+id/watched"
                style="@style/ActionButton"
                android:drawableStart="@drawable/ic_check"
                android:visibility="gone" />

            <TextView
                android:id="@+id/site"
                style="@style/ActionButton"
                android:drawableStart="@drawable/ic_series"
                android:text="@string/on_site" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_episodes_panel" />

    <include layout="@layout/view_choice_panel" />
</FrameLayout>
